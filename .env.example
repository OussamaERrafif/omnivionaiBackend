# ===================================================================
# OmniAI Backend Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your actual values
# ===================================================================

# === LLM providers ===
# The first configured provider in LLM_PROVIDER_ORDER is preferred. The next
# provider is tried automatically if a request to the previous one fails.
LLM_PROVIDER_ORDER=openai,nvidia,groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Keep a conservative cross-provider output limit and request timeout.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# === Supabase Configuration ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# === Payment Integration ===
LEMON_SQUEEZY_WEBHOOK_SECRET=your-lemon-squeezy-webhook-secret

# === Security Configuration ===
# ⚠️ CRITICAL: Set allowed origins for CORS (comma-separated list)
# Example for production: https://omniai.example.com,https://www.omniai.example.com
# Example for development: http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# === Environment ===
# Set to "production" to enable HTTPS redirect and restrict error details
ENV=development

# === Performance (Optional) ===
# Redis cache for improved performance (optional)
REDIS_URL=redis://localhost:6379/0
